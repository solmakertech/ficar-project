// database/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
  output   = "../../backend/node_modules/@prisma/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model FichaCatalografica {
  id        String   @id @default(cuid())
  titulo    String
  autor     String
  curso     String?
  tipo      String?
  programa  String?
  periodo   String?
  ano       Int?
  mes       Int?
  criado_em DateTime @default(now())
}
